.playwright-mcp

.vercel
.env*.local

# business cache: commit gzipped form only (raw .json is ~150MB, exceeds GitHub limit)
data/business-cache/**/*.json
!data/business-cache/**/*.json.gz

# peer snapshot: commit gzipped form only; builder intermediates are local-only
data/peer-snapshot/*.json
!data/peer-snapshot/*.json.gz
data/peer-snapshot/_progress/
data/peer-snapshot/_shared/

# 탐색용 임시 스크립트
scripts/_scratch/

# valuation cache: builder intermediates are local/CI-cache only
data/valuation-cache/_shared/
data/valuation-cache/_progress/
